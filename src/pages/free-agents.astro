---
import Base from '../layouts/Base.astro';
import FreeAgents from '../islands/FreeAgents';
import { threads } from '../lib/data';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const threadIds = Object.fromEntries(threads.filter((thread) => thread.mlbamId !== null).map((thread) => [String(thread.mlbamId), thread.id]));
---
<Base title="Free agents" description="This offseason's MLB free agents, linked to rumor threads.">
  <h1>Free agents</h1>
  <p class="lede">MLB's current list, requested live by your browser and linked to our rumor threads. Data © MLB Advanced Media, for individual, non-commercial use.</p>
  <FreeAgents client:load base={base} threadIds={threadIds} />
  <noscript><p>This list needs JavaScript, because it's read directly from MLB.</p></noscript>
</Base>
