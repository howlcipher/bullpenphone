---
import Base from '../../layouts/Base.astro';
import OfficialBadge from '../../islands/OfficialBadge';
import { STALE_DAYS, isStale, statusClass } from '../../core/display';
import { isHttpsUrl, type Thread } from '../../core/schemas';
import { threads } from '../../lib/data';
export function getStaticPaths() {
  return threads.map((thread) => ({ params: { id: thread.id }, props: { thread } }));
}
const { thread } = Astro.props as { thread: Thread };
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const date = (iso: string) => new Date(iso).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'UTC' }) + ' UTC';
const stale = isStale(thread.lastActivityAt, Date.now());
---
<Base title={thread.subject} description={`Reports about ${thread.subject}, linked to the original sources.`}>
  <article data-pagefind-body>
    <h1 data-pagefind-meta="title">{thread.subject}</h1>
    <div class="card-top">
      {thread.status && <span class={`pill ${statusClass(thread.status)}`}>{thread.status}</span>}
      {stale && <span class="pill">Quiet: no news in {STALE_DAYS}+ days</span>}
      {thread.teams.map((team) => <a class={`team-chip team-${team.toLowerCase()}`} href={`${base}team/${team.toLowerCase()}/`}>{team}</a>)}
    </div>
    {thread.mlbamId !== null && thread.type === 'player' && <OfficialBadge client:idle mlbamId={thread.mlbamId} teams={thread.teams} firstSeenAt={thread.firstSeenAt} />}
    <ol class="timeline">
      {thread.items.map((item) => (
        <li class={item.role}>
          <a class="headline" href={isHttpsUrl(item.url) ? item.url : undefined} rel="noopener nofollow">{item.title}</a>
          <div class="meta">
            <span>{item.sourceName}</span>
            {item.sourceKind === 'fansite' && <span class="pill">Fan site</span>}
            {item.status && item.status !== 'Unclassified' && <span class={`pill ${statusClass(item.status)}`}>{item.status}</span>}
            {item.role === 'mention' && <span>Mentioned in this report</span>}
            <span>Published <time datetime={item.publishedAt}>{date(item.publishedAt)}</time></span>
            <span>First seen here <time datetime={item.firstSeenAt}>{date(item.firstSeenAt)}</time></span>
          </div>
        </li>
      ))}
    </ol>
  </article>
</Base>
