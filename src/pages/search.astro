---
import Base from '../layouts/Base.astro';
import Search from '../islands/Search';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Search" description="Search rumor threads.">
  <h1>Search</h1>
  <Search client:load base={base} />
  <noscript><p>Search needs JavaScript.</p></noscript>
</Base>
