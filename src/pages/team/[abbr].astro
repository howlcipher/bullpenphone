---
import Base from '../../layouts/Base.astro';
import Board from '../../islands/Board';
import { TEAMS } from '../../core/teams';
import { latest, RAW_LATEST_URL } from '../../lib/data';
export function getStaticPaths() {
  return TEAMS.map((team) => ({ params: { abbr: team.abbr.toLowerCase() }, props: { team } }));
}
const { team } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const threads = latest.threads.filter((thread) => thread.teams.includes(team.abbr));
const feed = `${base}feeds/${team.abbr.toLowerCase()}.xml`;
---
<Base title={team.name} description={`Rumor threads involving the ${team.name}.`} feed={feed}>
  <h1>{team.name}</h1>
  <p class="lede">Threads involving this club. <a href={feed}>Subscribe with Atom</a>.</p>
  <Board client:load initial={threads} generatedAt={latest.generatedAt} base={base} rawUrl={RAW_LATEST_URL} pagesUrl={`${base}data/latest.json`} team={team.abbr} showMoves={false} />
</Base>
