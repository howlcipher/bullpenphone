---
import '../styles/global.css';
import { notice } from '../lib/data';
interface Props { title: string; description?: string; feed?: string }
const { title, description = 'Automated MLB rumor tracker: one page per story, with a clear status and links to the original reports.', feed } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const full = title === 'Hot Stove' ? title : `${title} | Hot Stove`;
const nav = [['', 'Board'], ['teams/', 'Teams'], ['deals/', 'Deals'], ['free-agents/', 'Free agents'], ['search/', 'Search'], ['about/', 'About']];
const path = Astro.url.pathname.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbf8f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16130f" media="(prefers-color-scheme: dark)" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href={`${base}icon.svg`} type="image/svg+xml" />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" type="application/atom+xml" title="Hot Stove: all threads" href={feed ?? `${base}feeds/all.xml`} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="wrap masthead-row">
        <a class="brand" href={base}><img src={`${base}icon.svg`} alt="" width="26" height="26" />Hot Stove</a>
        <nav aria-label="Main">
          <ul>
            {nav.map(([href, label]) => {
              const target = `${base}${href}`;
              const current = href === '' ? path === base : path.startsWith(target);
              return <li><a href={target} aria-current={current ? 'page' : undefined}>{label}</a></li>;
            })}
          </ul>
        </nav>
      </div>
    </header>
    {notice && <div class="notice" role="status"><div class="wrap">{notice}</div></div>}
    <main id="main" class="wrap"><slot /></main>
    <footer class="footer">
      <div class="wrap">
        <p><strong>Automated and unofficial.</strong> Software groups these reports and can get them wrong. Always check the original. Not affiliated with Major League Baseball, its clubs, or any outlet listed here.</p>
        <p><a href={`${base}about/`}>Sources and method</a> · <a href="https://github.com/howlcipher/hotstove/issues/new">Report a correction</a> · <a href={`${base}feeds/all.xml`}>Atom feed</a></p>
      </div>
    </footer>
  </body>
</html>
