---
import '../styles/global.css';
import { notice } from '../lib/data';
interface Props { title: string; description?: string; feed?: string }
const { title, description = 'Automated MLB tracker of trades, free agents and front office moves: one page per story, with links to the original reports.', feed } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const full = title === 'Bullpen Phone' ? title : `${title} | Bullpen Phone`;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = new URL(`${base}og-image.png`, Astro.site).href;
const shareAlt = "Bullpen Phone: Who's getting the call? Trades, free agents and front office.";
const nav = [['', 'Board'], ['teams/', 'Teams'], ['deals/', 'Deals'], ['free-agents/', 'Free agents'], ['search/', 'Search'], ['about/', 'About']];
const path = Astro.url.pathname.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#14213d" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1a33" media="(prefers-color-scheme: dark)" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href={`${base}icon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}icon-180.png`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <meta property="og:site_name" content="Bullpen Phone" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title === 'Bullpen Phone' ? "Bullpen Phone: Who's getting the call?" : full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content="noai, noimageai" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" type="application/atom+xml" title="Bullpen Phone: all threads" href={feed ?? `${base}feeds/all.xml`} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="wrap masthead-row">
        <a class="brand" href={base}><img src={`${base}icon.svg`} alt="" width="26" height="26" />Bullpen Phone</a>
        <nav aria-label="Main">
          <ul>
            {nav.map(([href, label]) => {
              const target = `${base}${href}`;
              const current = href === '' ? path === base : path.startsWith(target);
              return <li><a href={target} aria-current={current ? 'page' : undefined}>{label}</a></li>;
            })}
          </ul>
        </nav>
      </div>
    </header>
    {notice && <div class="notice" role="status"><div class="wrap">{notice}</div></div>}
    <main id="main" class="wrap"><slot /></main>
    <footer class="footer">
      <div class="wrap">
        <p><strong>Automated and unofficial.</strong> Software groups these reports and can get them wrong. Always check the original. Not affiliated with Major League Baseball, its clubs, or any outlet listed here.</p>
        <p><a href={`${base}about/`}>Sources and method</a> · <a href="https://github.com/howlcipher/bullpenphone/issues/new">Report a correction</a> · <a href={`${base}feeds/all.xml`}>Atom feed</a> · <a href={`${base}api/`}>API</a></p>
      </div>
    </footer>
  </body>
</html>
